{
  "name": "@beignet/portable-engine",
  "version": "0.1.0",
  "description": "Portable Beignet Bitcoin and Lightning engine for browser workers and React Native",
  "upstreamVersion": "0.21.7",
  "upstreamCommit": "63115a0d610f0fa36ea7e0a25468fdd97eb29bd0",
  "main": "dist/portable.cjs",
  "scripts": {
    "build": "node scripts/build-portable.cjs",
    "prepare": "npm run build",
    "test": "npm run build && node --test portable-tests/*.test.cjs",
    "test:regtest": "npm run build && node scripts/regtest.cjs",
    "test:regtest:channelize": "npm run build && node scripts/regtest-channelize.cjs",
    "test:smoke": "npm run build && node scripts/smoke-regtest.cjs",
    "test:regtest:ffor": "npm run build && node scripts/regtest-ffor.cjs",
    "test:regtest:ffor:native": "node scripts/regtest-ffor-native.cjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/coreyphillips/beignet.git",
    "baseUrl": "https://github.com/coreyphillips/beignet"
  },
  "keywords": [
    "Bitcoin",
    "wallet",
    "lightning",
    "lightning-network",
    "bolt",
    "ai-agent"
  ],
  "types": "portable/types.d.ts",
  "exports": {
    ".": {
      "types": "./portable/types.d.ts",
      "import": "./dist/portable.mjs",
      "require": "./dist/portable.cjs"
    },
    "./sqljs": {
      "types": "./portable/sqljs.d.ts",
      "import": "./dist/sqljs.mjs",
      "require": "./dist/sqljs.cjs"
    }
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist/",
    "portable/",
    "README.md",
    "README.upstream.md",
    "LICENSE"
  ],
  "author": "coreyphillips",
  "license": "MIT",
  "overrides": {
    "axios": "0.33.0",
    "js-yaml": "4.3.1",
    "serialize-javascript": "7.0.7"
  },
  "bugs": {
    "url": "https://github.com/coreyphillips/beignet/issues"
  },
  "homepage": "https://github.com/coreyphillips/beignet#readme",
  "dependencies": {
    "@bitcoinerlab/secp256k1": "1.0.5",
    "@brandonblack/musig": "^0.0.1-alpha.1",
    "@noble/ciphers": "1.3.0",
    "@noble/hashes": "1.8.0",
    "bech32": "2.0.0",
    "bip21": "2.0.3",
    "bip32": "4.0.0",
    "bip39": "3.1.0",
    "bitcoin-address-validation": "2.2.3",
    "bitcoin-units": "0.3.0",
    "bitcoinjs-lib": "6.1.4",
    "buffer": "6.0.3",
    "ecpair": "2.1.0",
    "events": "3.3.0",
    "fflate": "0.8.3",
    "lodash.clonedeep": "4.5.0",
    "path-browserify": "1.0.1",
    "rn-electrum-client": "0.0.22",
    "socks": "^2.8.7",
    "sql.js": "1.13.0",
    "stream-browserify": "3.0.0"
  },
  "devDependencies": {
    "@types/node": "22.18.0",
    "esbuild": "0.25.9",
    "typescript": "5.9.2"
  },
  "private": true,
  "module": "dist/portable.mjs"
}
